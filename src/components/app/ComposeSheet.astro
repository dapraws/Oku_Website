---
// The hero: Compose's dot-grid sheet, writing a day, then the next. Each entry types in the
// writer's hand, marks its mood, reasons, people and place, and sets a photo on the stack;
// then the ink lifts and the page turns to the next day. Every entry's text sits in the DOM
// (stacked in one grid cell), so only the Who row changes its height, and no-JS shows the first.
// Reduce Motion shows the first entry, finished.
import Icon from './Icon.astro';
import PlacePin from './PlacePin.astro';
import Polaroid from '../Polaroid.astro';
import { entries, moods, locales } from '../../entries';
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const list = entries[lang];
const t = {
  en: { today: 'Today', feeling: 'Feeling', reason: 'Reason', who: 'Who', where: 'Where', },
  id: { today: 'Hari ini', feeling: 'Perasaan', reason: 'Alasan', who: 'Siapa', where: 'Di mana' },
}[lang];
const tilts = [4, -4, 8];
---
<figure class="compose" data-compose data-locale={locales[lang]} data-days={list.map((e) => e.daysAgo).join(',')}
  data-moods={list.map((e) => e.mood).join(',')} data-people={list.map((e) => (e.person ? 1 : 0)).join(',')} role="img" aria-label={`${list[0].title}. ${list[0].body}`}>
  <div class="sheet" aria-hidden="true">
    <p class="label date" data-date>{t.today}</p>

    <p class="slot title">
      {list.map((e, i) => <span class:list={['e', { on: i === 0 }]} data-e={i} data-type>{e.title}</span>)}
    </p>
    <p class="slot words">
      {list.map((e, i) => <span class:list={['e', { on: i === 0 }]} data-e={i} data-type>{e.body}</span>)}
    </p>

    <div class="section" data-step>
      <p class="label"><Icon name="smiley" size={15} />{t.feeling}</p>
      <div class="chips">
        {moods[lang].map((m, i) => <span class:list={['chip', 'mood', { on: i === list[0].mood }]} data-mood={i}><i></i>{m}</span>)}
      </div>
    </div>

    <div class="section" data-step>
      <p class="label"><Icon name="question" size={15} />{t.reason}</p>
      <div class="slot">
        {list.map((e, i) => (
          <div class:list={['chips', 'e', { on: i === 0 }]} data-e={i}>
            {e.reasons.map((r, j) => <span class:list={['chip', { on: e.picked.includes(j) }]} data-pick={e.picked.includes(j) ? '' : undefined}>{r}</span>)}
          </div>
        ))}
      </div>
    </div>

    <div class="section row" data-step data-who hidden={!list[0].person}>
      <p class="label"><Icon name="users" size={15} />{t.who}</p>
      <span class="slot value">
        {list.map((e, i) => <span class:list={['e', { on: i === 0 }]} data-e={i} data-type>{e.person ?? ''}</span>)}
      </span>
    </div>

    <div class="section row" data-step>
      <p class="label"><Icon name="mapPin" size={15} />{t.where}</p>
      <span class="slot value">
        {list.map((e, i) => <span class:list={['e', 'place', { on: i === 0 }]} data-e={i}><span class="pin"><PlacePin size={16} /></span><span class="name">{e.place}</span></span>)}
      </span>
    </div>
  </div>

  <!-- The photo stack: each day's print lands on top. Hover or tap fans it, as in Entry Detail. -->
  <div class="photo" aria-hidden="true">
    <div class="stack" data-stack>
      {list.map((e, i) => (
        <Polaroid scene={e.scene} caption={e.place} tilt={tilts[i]} seed={i + 1}
          class={`print p${i}${i === 0 ? ' landed' : ''}`} />
      ))}
    </div>
  </div>

</figure>

<script>
  const fig = document.querySelector<HTMLElement>('[data-compose]');
  if (fig) {
    const locale = fig.dataset.locale ?? 'en-GB';
    const days = (fig.dataset.days ?? '0').split(',').map(Number);
    const moodOf = (fig.dataset.moods ?? '2').split(',').map(Number);
    const dateEl = fig.querySelector<HTMLElement>('[data-date]')!;
    const setDate = (i: number) => {
      const d = new Date();
      d.setDate(d.getDate() - days[i]);
      const parts = new Intl.DateTimeFormat(locale, { weekday: 'long', day: 'numeric', month: 'long' }).formatToParts(d);
      const get = (k: string) => parts.find((p) => p.type === k)?.value ?? '';
      dateEl.textContent = `${get('day')} ${get('month')} · ${get('weekday')}`; // app order
    };
    setDate(0);

    const stack = fig.querySelector<HTMLElement>('[data-stack]')!;
    stack.addEventListener('click', () => stack.classList.toggle('fanned'));

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) run(fig);

    function run(fig: HTMLElement) {
      const count = days.length;
      const people = (fig.dataset.people ?? '').split(',').map((v) => v === '1');
      const steps = [...fig.querySelectorAll<HTMLElement>('[data-step]')];
      const whoRow = fig.querySelector<HTMLElement>('[data-who]')!;
      const moodChips = [...fig.querySelectorAll<HTMLElement>('.mood')];
      const prints = [...fig.querySelectorAll<HTMLElement>('.print')];
      const sheet = fig.querySelector<HTMLElement>('.sheet')!;
      const caret = document.createElement('span');
      caret.className = 'caret';

      // Run only while the hero is on screen and the tab is visible.
      let onScreen = true;
      new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; }).observe(fig);
      const ready = () => onScreen && !document.hidden;
      const wait = (ms: number) => new Promise<void>((done) => {
        let left = ms, last = performance.now();
        const tick = (now: number) => {
          if (ready()) left -= now - last;
          last = now;
          left <= 0 ? done() : requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });

      // Split each typed text into a written part and a hidden remainder that holds its space.
      // Order in the DOM: titles, bodies, people (one per day each).
      const typers = [...fig.querySelectorAll<HTMLElement>('[data-type]')];
      const texts = new Map(typers.map((el) => [el, el.textContent ?? '']));
      for (const el of typers) {
        const done = document.createElement('span');
        const rest = document.createElement('span');
        rest.className = 'rest';
        el.replaceChildren(done, rest);
      }
      const clear = (el: HTMLElement) => {
        const [done, rest] = el.children as unknown as HTMLElement[];
        done.textContent = '';
        rest.textContent = texts.get(el)!;
      };
      const type = async (el: HTMLElement, speed: number) => {
        const text = texts.get(el)!;
        const [done, rest] = el.children as unknown as HTMLElement[];
        el.insertBefore(caret, rest);
        for (let i = 1; i <= text.length; i++) {
          done.textContent = text.slice(0, i);
          rest.textContent = text.slice(i);
          const ch = text[i - 1];
          await wait('.!?'.includes(ch) ? 340 : ',;'.includes(ch) ? 150 : speed + Math.random() * speed);
        }
      };

      // A finger tap: a soft ink ring where it lands, the chip pressed, then chosen.
      const tap = async (chip: HTMLElement) => {
        const ring = document.createElement('span');
        ring.className = 'tap';
        chip.append(ring);
        chip.classList.add('pressing');
        await wait(130);
        chip.classList.remove('pressing');
        chip.classList.add('picked');
        setTimeout(() => ring.remove(), 700);
      };

      const show = (i: number) => {
        for (const el of fig.querySelectorAll<HTMLElement>('[data-e]')) el.classList.toggle('on', el.dataset.e === String(i));
        // Days without people drop the Who row; the sheet eases to its new height.
        const from = sheet.offsetHeight;
        whoRow.hidden = !people[i];
        const to = sheet.offsetHeight;
        if (from !== to && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          sheet.animate({ height: [`${from}px`, `${to}px`] }, { duration: 420, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
        }
        setDate(i);
        fig.setAttribute('aria-label', `${texts.get(typers[i])}. ${texts.get(typers[count + i])}`);
      };
      const reset = () => {
        typers.forEach(clear);
        steps.forEach((s) => s.classList.remove('shown'));
        fig.querySelectorAll('.picked, .dropped').forEach((c) => c.classList.remove('picked', 'dropped'));
      };

      fig.classList.add('staged');
      reset();
      let z = 10;

      const write = async (i: number) => {
        show(i);
        await wait(450);
        await type(typers[i], 55);          // title
        await wait(300);
        await type(typers[count + i], 15);  // body
        caret.remove();
        await wait(450);
        for (const [n, step] of steps.entries()) {
          if (step.hidden) continue;
          step.classList.add('shown');
          await wait(300);
          if (step === whoRow) {
            await type(typers[2 * count + i], 60);   // the person, typed in
            caret.remove();
          } else if (n === steps.length - 1) {
            step.querySelector('.place.on')?.classList.add('dropped');   // the pin drops in
            await wait(500);
          } else {
            const picks = n === 0 ? [moodChips[moodOf[i]]] : [...step.querySelectorAll<HTMLElement>('.e.on [data-pick]')];
            for (const pick of picks) { await tap(pick); await wait(320); }
          }
          await wait(140);
        }
        const print = prints[i];
        print.style.zIndex = String(++z);
        print.classList.remove('landed');
        void print.offsetWidth; // restart the drop
        print.classList.add('landed');
      };

      const turn = async () => {
        caret.remove();
        sheet.classList.add('lifting');
        await wait(360);
        reset();
        sheet.classList.remove('lifting');
      };

      (async () => {
        for (let i = 0; ; i = (i + 1) % count) {
          if (i === 0) prints.forEach((p) => p.classList.remove('landed'));
          await write(i);
          await wait(3600);
          await turn();
        }
      })();
    }
  }
</script>

<style>
  .compose { position: relative; margin: 0; }
  .sheet {
    position: relative;
    color: var(--ink);
    padding: 1.5rem 1.5rem 1.75rem;
    background-color: var(--paper);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--ink-3) 35%, transparent) 0.75px, transparent 1.1px);
    background-size: 20px 20px;
    background-position: 10px 10px;
    border: var(--hairline) solid var(--rule);
    box-shadow: var(--shadow-print);
  }
  p { margin: 0; }
  .label { display: flex; align-items: center; gap: 0.4rem; color: var(--ink-2); }
  .date { margin-bottom: 1.25rem; }

  /* Every entry sits in one grid cell; only the current one is visible, so height never jumps. */
  .slot { display: grid; }
  .slot > .e { grid-area: 1 / 1; visibility: hidden; }
  .slot > .e.on { visibility: visible; }

  .title { font-family: var(--hand); font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1.15; margin-bottom: 0.5rem; }
  .words { font-family: var(--hand); font-size: clamp(1.1875rem, 1.05rem + 0.4vw, 1.375rem); line-height: 1.5; margin-bottom: 1.5rem; }

  .section { padding: 0.875rem 0; border-top: var(--hairline) solid var(--rule); }
  .section > .label { margin-bottom: 0.625rem; }
  .row { display: flex; align-items: center; gap: 2rem; }
  .row > .label { margin: 0; min-width: 5.5rem; }
  .value { font-size: 1.0625rem; }
  .value .add { font-size: 0.9375rem; color: var(--ink-2); text-decoration: underline; text-decoration-thickness: var(--hairline); text-underline-offset: 0.2em; }
  .place { display: inline-flex; align-items: center; gap: 0.5rem; }
  .pin, .name { display: inline-flex; }
  /* The place is chosen: the pin drops onto the line, then the name settles in. */
  .staged .place:not(.dropped) .pin { opacity: 0; translate: 0 -0.9rem; }
  .staged .place:not(.dropped) .name { opacity: 0; filter: blur(4px); }
  .staged .place.dropped .pin { animation: pin-drop 420ms var(--ease) both; }
  .staged .place.dropped .name { animation: bloom 320ms ease-out 240ms both; }
  @keyframes pin-drop { from { opacity: 0; translate: 0 -0.9rem; } 70% { opacity: 1; } }

  .chips { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 0.375rem; }
  /* DESIGN.md chip: callout serif, 0.5pt rule outline, 2px radius */
  .chip {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.9375rem; color: var(--ink-2);
    border: var(--hairline) solid var(--rule); border-radius: 2px;
    transition: background-color 200ms ease-out, border-color 200ms ease-out, color 200ms ease-out;
  }
  .chip i { width: 5px; height: 5px; border-radius: 50%; background: var(--ink-3); transition: background-color 200ms ease-out; }
  .chip.on { background: var(--paper-raised); color: var(--ink); border-color: var(--teak); }
  .chip { position: relative; transition: scale 120ms ease-out, background-color 200ms ease-out, border-color 200ms ease-out, color 200ms ease-out; }
  .chip.pressing { scale: 0.95; }
  /* Where a finger lands: a soft ink ring that opens and fades. */
  .chip :global(.tap) {
    position: absolute; left: 50%; top: 50%;
    width: 2.75rem; height: 2.75rem; margin: -1.375rem 0 0 -1.375rem;
    border-radius: 50%; background: var(--ink); pointer-events: none;
    animation: tap 620ms ease-out forwards;
  }
  @keyframes tap { from { scale: 0.2; opacity: 0.28; } to { scale: 1.7; opacity: 0; } }
  .row[hidden] { display: none; }
  .chip.on i { background: var(--teak); }

  /* Phones: the stack hangs below the sheet, clear of the rows. */
  .photo { position: absolute; right: -0.25rem; bottom: -7rem; width: 8.5rem; }
  @media (min-width: 40rem) { .photo { right: -1.25rem; bottom: -3.5rem; width: 9.5rem; } }
  .photo :global(.polaroid) { width: 100%; padding: 0.5rem 0.5rem 0; }
  .photo :global(figcaption) { height: 1.875rem; font-size: 1rem; }

  .stack { position: relative; cursor: pointer; }
  .stack :global(.print) { transition: rotate 520ms var(--spring), translate 520ms var(--spring); }
  .stack :global(.print:not(.p0)) { position: absolute; inset: 0 auto auto 0; }
  .stack :global(.p1) { translate: -7% 3%; }
  .stack :global(.p2) { translate: 6% -3%; }
  .stack:hover :global(.p0), .stack.fanned :global(.p0) { rotate: 2deg; translate: 0 -2%; }
  .stack:hover :global(.p1), .stack.fanned :global(.p1) { rotate: -13deg; translate: -62% 6%; }
  .stack:hover :global(.p2), .stack.fanned :global(.p2) { rotate: 14deg; translate: 52% 4%; }


  /* Staged by the script only. */
  .staged :global(.rest) { visibility: hidden; }
  .staged :global(.caret) {
    display: inline-block; width: 2px; height: 1em; margin: 0 1px -0.12em;
    background: var(--teak); animation: blink 1s steps(1) infinite;
  }
  .staged [data-step] { opacity: 0; translate: 0 6px; transition: opacity 320ms var(--ease), translate 320ms var(--ease); }
  .staged [data-step].shown { opacity: 1; translate: 0 0; }
  .staged .chip.on:not(.picked), .staged .mood:not(.picked) { background: transparent; color: var(--ink-2); border-color: var(--rule); }
  .staged .chip:not(.picked) i { background: var(--ink-3); }
  .staged .chip.picked { background: var(--paper-raised); color: var(--ink); border-color: var(--teak); }
  .staged .chip.picked i { background: var(--teak); }
  /* A print lands: from above, turned, then set down. */
  .staged :global(.print) { opacity: 0; }
  .staged :global(.print.landed) { opacity: 1; animation: land 640ms var(--ease) both; }
  @keyframes land { from { opacity: 0; transform: translate(0.5rem, -1.75rem) rotate(-8deg); } }
  /* Ink lift: the page clears before the next day is written (DESIGN.md motion). */
  .sheet.lifting .title, .sheet.lifting .words, .sheet.lifting [data-step] {
    opacity: 0; filter: blur(4px); translate: 0 -4px;
    transition: opacity 320ms ease-out, filter 320ms ease-out, translate 320ms ease-out;
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
