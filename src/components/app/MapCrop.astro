---
// The real Stories map (Java and Bali with the app's pins), cropped from the app capture.
import { Image } from 'astro:assets';
import en from '../../assets/screens/en/map-bali.webp';
import id from '../../assets/screens/id/map-bali.webp';
import type { Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Image src={lang === 'en' ? en : id} alt="" widths={[280, 560]} sizes="17rem" loading="lazy" />
