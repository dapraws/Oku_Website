---
// One of the app's painted demo scenes, drawn once at build time (src/paint.ts) and served
// as a static SVG, so the page carries a reference instead of the drawing.
import type { Scene } from '../../entries';
interface Props { scene: Scene; seed?: number }
const { scene } = Astro.props;
---
<img class="painting" src={`/paintings/${scene}.svg`} alt="" loading="lazy" decoding="async" />

<style>
  .painting { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
