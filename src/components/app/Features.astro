---
// "Write a line or a page" and the rest of Oku: the STORE.md paragraph in the middle, its key
// phrases marked in teak as it comes into view, and small pieces of the app floating around it.
// Each piece carries one feature; copy is the app's own strings and STORE.md's list.
// Floating pauses off screen; Reduce Motion holds everything still.
import Icon from './Icon.astro';
import PlacePin from './PlacePin.astro';
import { moods } from '../../entries';
import type { Lang } from '../../i18n';

interface Props { lang: Lang; title: string; note: string }
const { lang, title, note } = Astro.props;

const t = {
  en: {
    body: 'Mark how the day felt in one word, [from Heavy to Bright], and pick up to [three reasons] why. Add the place, the people who were there, and a few photos, which Oku keeps as [polaroids]. If you don’t know how to start, [borrow a line] and keep going. Missed a day? Write it under [its own date].',
    feeling: 'Feeling', borrow: 'Borrow a line',
    lines: ['Today I went ', 'I want to remember ', 'The best part was ___.', 'Something small that happened '],
    voice: 'Voice note', voiceNote: 'Turned into text on your iPhone',
    now: 'now', reminder: 'The page waits.', reminderLabel: 'Daily reminder',
    unlock: 'Unlock with Face ID', icons: 'App icon',
    deleted: 'Recently deleted', deletedEntry: 'Long day', gone: 'Gone in 28 days',
    language: 'Language', appearance: 'Light and dark',
  },
  id: {
    body: 'Tandai perasaanmu hari itu dengan satu kata, [dari Berat sampai Cerah], lalu pilih sampai [tiga alasannya]. Tambahkan tempat, orang-orang yang ada di sana, dan beberapa foto yang disimpan Oku sebagai [polaroid]. Bingung mulai dari mana? [Pinjam satu kalimat], lalu lanjutkan. Ada hari yang terlewat? Tulis di [tanggalnya sendiri].',
    feeling: 'Perasaan', borrow: 'Pinjam kalimat',
    lines: ['Hari ini aku pergi ', 'Aku ingin mengingat ', 'Bagian terbaiknya ___.', 'Hal kecil yang terjadi '],
    voice: '', voiceNote: '',
    now: 'sekarang', reminder: 'Halaman menunggu.', reminderLabel: 'Pengingat harian',
    unlock: 'Buka dengan Face ID', icons: 'Ikon aplikasi',
    deleted: 'Baru dihapus', deletedEntry: 'Hari yang panjang', gone: 'Hilang dalam 28 hari',
    language: 'Bahasa', appearance: 'Terang dan gelap',
  },
}[lang];

// [phrase] → a phrase that gets a hand-drawn teak underline.
const parts = t.body.split(/(\[[^\]]+\])/).map((p) => (p.startsWith('[') ? { mark: p.slice(1, -1) } : { text: p }));
const bars = Array.from({ length: 22 }, (_, i) => 0.25 + 0.75 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6)));
---
<div class="board" data-board>
  <div class="center">
    <h2 set:html={title} />
    <p class="body">
      {parts.map((p, i) => p.mark
        ? <mark class="scribble" style={`--i: ${i}`}>{p.mark}<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M1 6 C 20 3, 40 8, 60 5 S 90 4, 99 6" pathLength="1" /></svg></mark>
        : <span>{p.text}</span>)}
    </p>
    <p class="note">{note}</p>
  </div>

  <div class="pieces" aria-hidden="true">
    <div class="piece mood-scale" style="--d: 7s; --o: -0.4s; --r: -2deg">
      <p class="label"><Icon name="smiley" size={14} />{t.feeling}</p>
      <div class="scale" data-scale>
        <span class="track"></span>
        {moods[lang].map((_, i) => <i style={`--x: ${i * 25}%`}></i>)}
        <b class="marker"></b>
      </div>
      <p class="mood-word" data-mood-word data-words={moods[lang].join('|')}>{moods[lang][2]}</p>
    </div>

    <div class="piece borrow" style="--d: 8.5s; --o: -2s; --r: 1.5deg">
      <p class="label">{t.borrow}</p>
      <p class="hand" data-borrow data-lines={JSON.stringify(t.lines)}>{t.lines[0]}</p>
    </div>

    {t.voice && (
      <div class="piece voice" style="--d: 7.8s; --o: -1.2s; --r: -1deg">
        <p class="label">{t.voice}</p>
        <div class="wave">{bars.map((h, i) => <i style={`--h: ${h}; --i: ${i}`}></i>)}</div>
        <p class="small">{t.voiceNote}</p>
      </div>
    )}

    <div class="piece notice" style="--d: 9s; --o: -3s; --r: 1deg">
      <span class="app-icon"><b></b></span>
      <div>
        <p class="notice-head"><span>Oku</span><span>{t.now}</span></p>
        <p class="notice-body">{t.reminder}</p>
      </div>
    </div>

    <div class="piece lock" style="--d: 8s; --o: -0.8s; --r: -1.5deg">
      <span class="lock-mark"><b></b></span>
      <p class="lock-word">Oku</p>
      <p class="lock-action">{t.unlock}</p>
    </div>

    <div class="piece icons" style="--d: 7.4s; --o: -2.6s; --r: 2deg">
      <p class="label">{t.icons}</p>
      <div class="icon-row">
        <span class="app mark"><b></b></span>
        <span class="app word">Oku</span>
        <span class="app kanji">奥</span>
      </div>
    </div>

    <div class="piece deleted" style="--d: 8.8s; --o: -1.6s; --r: -1deg">
      <p class="label">{t.deleted}</p>
      <p class="deleted-row"><span>{t.deletedEntry}</span><span class="gone">{t.gone}</span></p>
    </div>

    <div class="piece lang" style="--d: 7.6s; --o: -3.4s; --r: 1.5deg">
      <p class="label">{t.language}</p>
      <div class="seg"><span>English</span><span>Indonesia</span><b class="thumb"></b></div>
    </div>

    <div class="piece where" style="--d: 9.4s; --o: -2.2s; --r: -2deg">
      <p class="label"><Icon name="mapPin" size={14} /></p>
      <p class="place"><PlacePin size={16} />Kuta</p>
    </div>
  </div>
</div>

<script>
  const board = document.querySelector<HTMLElement>('[data-board]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (board && !still) {
    let visible = false;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      board.classList.toggle('live', visible);
      if (visible) board.classList.add('marked');
    }, { threshold: 0.2 }).observe(board);

    // Feeling: the marker steps along Heavy → Bright.
    const scale = board.querySelector<HTMLElement>('[data-scale]');
    const word = board.querySelector<HTMLElement>('[data-mood-word]');
    let m = 2;
    const words = word ? (word.dataset.words ?? '').split('|') : [];
    setInterval(() => {
      if (!visible || document.hidden || !scale || !word) return;
      m = (m + 1) % 5;
      scale.style.setProperty('--m', String(m));
      word.textContent = words[m] ?? word.textContent;
    }, 1600);

    // Borrow a line: one of the app's openers is written, then rubbed out for the next.
    const borrow = board.querySelector<HTMLElement>('[data-borrow]');
    const lines: string[] = borrow ? JSON.parse(borrow.dataset.lines ?? '[]') : [];
    let li = 0;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const until = async () => { while (!visible || document.hidden) await wait(300); };
    (async () => {
      if (!borrow || !lines.length) return;
      for (;;) {
        const text = lines[li];
        for (let i = 1; i <= text.length; i++) { await until(); borrow.textContent = text.slice(0, i); await wait(55 + Math.random() * 40); }
        await wait(2200);
        for (let i = text.length; i >= 0; i--) { await until(); borrow.textContent = text.slice(0, i); await wait(18); }
        await wait(300);
        li = (li + 1) % lines.length;
      }
    })();
  }
</script>

<style>
  .board { position: relative; }
  .center { position: relative; z-index: 1; max-width: 40rem; margin: 0 auto; text-align: center; }
  h2 {
    font-size: clamp(2.25rem, 1.35rem + 3.3vw, 4.25rem); font-weight: 500;
    line-height: 1.04; letter-spacing: -0.022em; margin: 0 0 1.5rem; text-wrap: balance;
  }
  h2 :global(em) { font-style: italic; font-weight: 400; }
  .body { font-size: clamp(1.1875rem, 1rem + 0.7vw, 1.5rem); line-height: 1.6; margin: 0; text-wrap: pretty; }
  .note { font-size: 0.9375rem; color: var(--ink-2); margin: 1.5rem 0 0; }

  /* A phrase marked by hand: the teak stroke draws in under it, one after another. */
  .scribble { position: relative; background: none; color: inherit; white-space: nowrap; }
  .scribble svg { position: absolute; left: -2%; bottom: -0.28em; width: 104%; height: 0.5em; overflow: visible; }
  .scribble path { fill: none; stroke: var(--teak); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .board:not(.marked) .scribble path { stroke-dashoffset: 1; }
    .board.marked .scribble path { transition: stroke-dashoffset 700ms var(--ease); transition-delay: calc(var(--i) * 220ms + 300ms); }
  }

  /* Pieces of the app, each a small slip that floats. */
  /* Phones: one loose column, slips stepping left and right. */
  .pieces { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .piece {
    padding: 0.875rem 1rem; background: var(--paper-raised); border-radius: 4px;
    box-shadow: 0 6px 24px rgba(26, 22, 20, 0.08), 0 1px 2px rgba(26, 22, 20, 0.06);
    rotate: var(--r);
  }
  .piece p { margin: 0; }
  .piece .label { display: flex; align-items: center; gap: 0.35rem; color: var(--ink-2); margin-bottom: 0.625rem; }
  @media (prefers-reduced-motion: no-preference) {
    .piece { animation: drift var(--d) ease-in-out var(--o) infinite alternate; animation-play-state: paused; transition: box-shadow 200ms ease-out; }
    .board.live .piece { animation-play-state: running; }
    .piece:hover { box-shadow: 0 14px 34px rgba(26, 22, 20, 0.14), 0 2px 4px rgba(26, 22, 20, 0.08); }
  }
  @keyframes drift { from { translate: 0 -5px; } to { translate: 0 6px; } }

  /* Desktop: the pieces float in a loose ring around the paragraph. */
  @media (min-width: 64rem) {
    .board { min-height: 46rem; display: grid; place-items: center; padding: 4rem 0; }
    .center { max-width: 34rem; }
    .pieces { position: absolute; inset: 0; display: block; margin: 0; }
    .piece { position: absolute; width: 14rem; }
    .mood-scale { left: 0; top: 4%; }
    .borrow { left: 2%; top: 40%; width: 15rem; }
    .voice { left: 4%; bottom: 4%; }
    .notice { right: 0; top: 2%; width: 17rem; }
    .lock { right: 4%; top: 30%; width: 11rem; }
    .icons { right: 1%; bottom: 22%; width: 12rem; }
    .deleted { left: 32%; bottom: -2%; width: 15rem; }
    .lang { right: 22%; bottom: -1%; width: 13rem; }
    .where { left: 23%; top: -2%; width: 9rem; }
  }
  @media (max-width: 63.99rem) {
    .where, .lock { display: none; }
    .piece { width: 86%; }
    .piece:nth-child(even) { justify-self: end; }
  }

  /* Feeling scale */
  .scale { position: relative; height: 1.25rem; margin: 0 0.5rem; --m: 2; }
  .track { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--rule); }
  .scale i { position: absolute; top: 50%; left: var(--x); width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%; background: var(--ink-3); }
  .marker {
    position: absolute; top: 50%; left: calc(var(--m) * 25%); width: 14px; height: 14px; margin: -7px 0 0 -7px;
    border-radius: 50%; background: var(--paper); border: 2.5px solid var(--teak);
    transition: left 520ms var(--ease);
  }
  .mood-word { margin-top: 0.5rem !important; font-size: 1.0625rem; }

  .hand { font-family: var(--hand); font-size: 1.25rem; min-height: 1.6em; line-height: 1.3; }
  .hand::after { content: ''; display: inline-block; width: 2px; height: 1em; margin-left: 1px; vertical-align: -0.12em; background: var(--teak); animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .wave { display: flex; align-items: center; gap: 3px; height: 2rem; }
  .wave i { flex: 1; height: calc(var(--h) * 100%); background: var(--teak); border-radius: 1px; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .board.live .wave i { animation: talk 900ms ease-in-out calc(var(--i) * -70ms) infinite alternate; }
  }
  @keyframes talk { to { scale: 1 0.35; } }
  .small { font-size: 0.8125rem; color: var(--ink-2); margin-top: 0.5rem !important; }

  .notice { display: flex; gap: 0.75rem; align-items: center; border-radius: 14px; }
  .app-icon { flex: none; width: 2.25rem; height: 2.25rem; border-radius: 0.55rem; display: grid; place-items: center; background: #DED5C0; }
  .app-icon b, .app.mark b, .lock-mark b { width: 60%; height: 60%; border-radius: 50%; border: 1.5px solid #1A1614; display: grid; place-items: center; }
  .app-icon b::after, .app.mark b::after { content: ''; width: 34%; height: 34%; border-radius: 50%; background: #1A1614; }
  .notice-head { display: flex; justify-content: space-between; font-size: 0.8125rem; font-weight: 600; }
  .notice-head span:last-child { font-weight: 400; color: var(--ink-3); }
  .notice-body { font-size: 0.9375rem; color: var(--ink-2); }

  .lock { text-align: center; padding-block: 1.25rem; }
  .lock-mark { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; }
  .lock-mark b { width: 100%; height: 100%; border-color: var(--ink); }
  .lock-mark b::after { content: ''; width: 30%; height: 30%; border-radius: 50%; background: var(--ink); }
  .lock-word { font-size: 1.125rem; margin: 0.25rem 0 0.75rem !important; }
  .lock-action { font-size: 0.875rem; text-decoration: underline; text-decoration-thickness: var(--hairline); text-underline-offset: 0.2em; }

  .icon-row { display: flex; gap: 0.5rem; }
  .app { width: 2.5rem; height: 2.5rem; border-radius: 0.6rem; display: grid; place-items: center; background: #DED5C0; color: #1A1614; box-shadow: 0 0 0 0.5px rgba(26, 22, 20, 0.15); }
  .app.word { font-family: var(--serif); font-size: 0.875rem; }
  .app.kanji { font-family: var(--serif); font-size: 1.25rem; }
  .app:nth-child(2) { background: #1A1614; color: #EDE7D9; }

  .deleted-row { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9375rem; }
  .gone { color: var(--ink-3); font-family: var(--mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; align-self: center; }

  .seg { position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: 3px; background: var(--paper-sunken); border-radius: 4px; font: 500 0.6875rem/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .seg span { position: relative; z-index: 1; text-align: center; padding: 0.55rem 0; }
  .thumb { position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px); background: var(--paper); border-radius: 2px; box-shadow: 0 1px 2px rgba(26, 22, 20, 0.1); }
  @media (prefers-reduced-motion: no-preference) {
    .board.live .thumb { animation: swap 5s ease-in-out infinite; }
  }
  @keyframes swap { 0%, 40% { translate: 0 0; } 50%, 90% { translate: 100% 0; } 100% { translate: 0 0; } }

  .place { display: flex; align-items: center; gap: 0.5rem; font-size: 1.0625rem; }
</style>
