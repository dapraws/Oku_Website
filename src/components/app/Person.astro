---
// A small drawn portrait for the people in a day (invented: Dimas, Mum/Ibu, Najla).
// Ink outlines follow the theme; skin, hair and cloth keep their own colours.
interface Props { who: 'dimas' | 'mum' | 'najla'; size?: number }
const { who, size = 48 } = Astro.props;
const id = `clip-${who}`;
---
<svg class="person" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <defs><clipPath id={id}><circle cx="32" cy="32" r="31" /></clipPath></defs>
  <circle cx="32" cy="32" r="31" class="ground" />
  <g clip-path={`url(#${id})`} class="ink">
    {who === 'dimas' && (
      <>
        <path d="M6,66 C8,51 19,45 32,45 C45,45 56,51 58,66 Z" fill="#4A423D" />
        <rect x="28" y="37" width="8" height="9" fill="#B98563" />
        <ellipse cx="32" cy="29" rx="10.5" ry="12" fill="#C8956C" />
        <path d="M21.4,28 C20.6,17 26.5,14 32.6,14.4 C39.3,14 44.2,18.5 42.8,28 C40.4,22.6 35.6,21.4 30.6,22.1 C26.2,22.7 23.2,24.6 21.4,28 Z" fill="#1A1614" />
        <circle cx="27.8" cy="30" r="3.3" fill="none" />
        <circle cx="36.4" cy="30" r="3.3" fill="none" />
        <path d="M31.1,30 h2" fill="none" />
        <path d="M28.6,36.2 Q32.2,38.8 35.8,36.2" fill="none" />
      </>
    )}
    {who === 'mum' && (
      <>
        <path d="M5,66 C7,52 18,47 32,47 C46,47 57,52 59,66 Z" fill="#5E7564" />
        <path d="M18.5,66 L19.6,40 C19,24 25,14.6 32,14.6 C39,14.6 45,24 44.4,40 L45.5,66 Z" fill="#9C6B3F" />
        <ellipse cx="32" cy="30.5" rx="8.6" ry="10.2" fill="#C99A72" />
        <path d="M27.2,29.4 q1.6,1.3 3.2,0 M33.6,29.4 q1.6,1.3 3.2,0" fill="none" />
        <path d="M29,35.6 Q32,38 35,35.6" fill="none" />
        <circle cx="26.6" cy="33.4" r="1.6" fill="#C08850" stroke="none" opacity="0.35" />
        <circle cx="37.4" cy="33.4" r="1.6" fill="#C08850" stroke="none" opacity="0.35" />
      </>
    )}
    {who === 'najla' && (
      <>
        <path d="M18.6,58 C16.6,40 17.6,17.6 32,15.8 C46.4,17.6 47.4,40 45.4,58 Z" fill="#2A2621" />
        <path d="M6,66 C8,52 19,46 32,46 C45,46 56,52 58,66 Z" fill="#C08850" />
        <rect x="28.2" y="38" width="7.6" height="9" fill="#C99A72" />
        <ellipse cx="32" cy="30" rx="9.6" ry="11.2" fill="#D8AE8A" />
        <path d="M22.4,28 C22.6,20.4 27.6,18.4 32,18.4 C37,18.4 41.6,20.6 41.6,28 C38.4,23.4 34.2,22.8 31,24.6 C28,23 25,24.4 22.4,28 Z" fill="#2A2621" />
        <circle cx="28.4" cy="30.4" r="1" fill="#1A1614" stroke="none" />
        <circle cx="35.6" cy="30.4" r="1" fill="#1A1614" stroke="none" />
        <path d="M29.2,35.6 Q32,37.8 34.8,35.6" fill="none" />
        <circle cx="26.4" cy="33.6" r="1.6" fill="#C08850" stroke="none" opacity="0.4" />
        <circle cx="37.6" cy="33.6" r="1.6" fill="#C08850" stroke="none" opacity="0.4" />
      </>
    )}
  </g>
  <circle cx="32" cy="32" r="31" class="rim" />
</svg>

<style>
  .person { display: block; flex: none; }
  .ground { fill: var(--paper-sunken); }
  .ink :global(*) { stroke: #1A1614; stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round; }
  .rim { fill: none; stroke: var(--paper-raised); stroke-width: 2.5; }
</style>
