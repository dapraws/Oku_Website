---
// A cut-paper silhouette for the people in a day (invented: Dimas, Mum/Ibu, Najla).
// One colour: the ink of the theme, with paper showing through the cuts.
interface Props { who: 'dimas' | 'mum' | 'najla' }
const { who } = Astro.props;
const shapes = {
  dimas: {
    body: 'M16,124 C16,106 25,97 38,93 L40,81 C37,77 32,71 30,63 C27,52 29,37 37,27 C43,20 50,17.5 57,17.5 C66,17.5 72,22 73.4,29 C73.6,31 73,32.6 72.4,33.6 L72.2,40 C73,41.6 73.8,43 73.6,45 L79.2,55 C79.8,56.6 78.6,57.8 76.6,57.8 L74.8,58.2 C75.4,59.6 75.4,61 74.2,61.8 C75.2,63 74.8,65 73.4,65.6 C73.6,67.2 74.4,68.8 74,70.6 C72.8,74.6 68.4,76 63.8,75.6 L61.8,80.6 C63,87 69,91 77,94 C85,98 88,108 88,124 Z',
    cuts: 'M45,50.6 L66.4,47.6 M66.4,45 C69.4,44.6 71.2,45.6 71.2,48.4 C71.2,51.2 69.4,52.4 66.6,52',
  },
  mum: {
    body: 'M10,124 C10,106 17,95 25,87 C29,80 26,71 26,58 C26,32 40,15 57,15 C69,15 76,23 77,33 L75,38.4 C75.4,41 76,42.6 75.6,44.4 L80,53.6 C80.6,55.2 79.6,56.4 77.8,56.4 L76,56.8 C76.6,58.2 76.6,59.6 75.4,60.4 C76.4,61.6 76,63.6 74.6,64.2 C74.8,65.8 75.4,67.6 74.4,69.6 C77,73 81,78 85,84 C89,91 91,104 91,124 Z',
    cuts: 'M75,38.4 C70,40.4 66.6,46.4 66.8,54.4 C67,62 69.6,67.6 74.4,69.6 M40,30 C33,42 31,58 33,74 C34,82 32,90 28,96',
  },
  najla: {
    body: 'M13,124 C13,110 19,101 27,97 C23,90 21,80 22,66 C21,55 25,43 29,35 C34,23 44,17.5 56.5,17.5 C66,17.5 72.4,22.6 73.8,31 L72.8,39.6 C73.4,41.4 74.2,43 73.8,44.8 L78,53.6 C78.6,55 77.6,56.2 76,56.2 L74.4,56.6 C75,58 75,59.4 73.8,60.2 C74.8,61.4 74.4,63.2 73,63.8 C73.2,65.6 73.6,67.4 72.8,69.4 C71.4,72.8 67.4,73.8 63.6,73.4 L62.4,79 C63.8,85 69.4,89 76,92 C84,96 86,106 86,124 Z',
    cuts: 'M57,18.4 C46,24 39,36 37,50 C35,64 36,78 40,90',
  },
};
const { body, cuts } = shapes[who];
const id = `cameo-${who}`;
---
<svg class="person" viewBox="6 10 92 110" aria-hidden="true">
  <defs><clipPath id={id}><ellipse cx="52" cy="65" rx="45" ry="54" /></clipPath></defs>
  <ellipse cx="52" cy="65" rx="45" ry="54" class="ground" />
  <g clip-path={`url(#${id})`}>
    <path d={body} class="cut" />
    <path d={cuts} class="slit" />
  </g>
  <ellipse cx="52" cy="65" rx="45" ry="54" class="rim" />
</svg>

<style>
  .person { display: block; flex: none; filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.18)); }
  .ground { fill: var(--paper-raised); }
  .cut { fill: var(--ink); }
  .slit { fill: none; stroke: var(--paper-raised); stroke-width: 1.8; stroke-linecap: round; }
  .rim { fill: none; stroke: var(--ink); stroke-width: 1.6; }
</style>
