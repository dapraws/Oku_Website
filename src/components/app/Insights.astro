---
// Oku's Insights, rebuilt from DESIGN.md with example data, and usable: pick a timeframe and the
// mood line redraws, touch a point for its day, pick a reason to see its share and usual mood.
// Draws in once when it scrolls into view. Dates are filled in on the client, relative to today.
import Icon from './Icon.astro';
import { moods, locales } from '../../entries';
import type { Lang } from '../../i18n';

interface Props { lang: Lang; label: string }
const { lang, label } = Astro.props;

const t = {
  en: {
    stats: ['entries', 'this week', 'days this month'],
    mood: 'mood over time', frames: ['30 days', '90 days', 'all time'],
    mostly: 'Mostly', across: (n: number) => `across ${n} days`,
    first: 'First', last: 'Last', journaling: '57 days journaling',
    rhythm: 'rhythm · last 12 weeks', days: ['M', 'T', 'W', 'T', 'F', 'S', 'S'],
    peak: 'Most often on Tuesday.', why: 'why · 30 days', usually: 'Usually',
    reasons: ['Self', 'Friends', 'Health', 'Work', 'School'],
  },
  id: {
    stats: ['catatan', 'minggu ini', 'hari bulan ini'],
    mood: 'suasana hati', frames: ['30 hari', '90 hari', 'sepanjang waktu'],
    mostly: 'Kebanyakan', across: (n: number) => `dari ${n} hari`,
    first: 'Pertama', last: 'Terakhir', journaling: '57 hari menulis',
    rhythm: 'ritme · 12 minggu terakhir', days: ['S', 'S', 'R', 'K', 'J', 'S', 'M'],
    peak: 'Paling sering di hari Selasa.', why: 'alasan · 30 hari', usually: 'Biasanya',
    reasons: ['Diri sendiri', 'Teman', 'Kesehatan', 'Kerja', 'Sekolah'],
  },
}[lang];
const levels = moods[lang];

// Three timeframes, 16 points each so a switch reads as one line changing its mind.
const frames = [
  { span: 29, days: 16, mood: [5, 1, 4, 3, 4, 2, 4, 5, 2, 4, 5, 3, 4, 4, 3, 3] },
  { span: 89, days: 41, mood: [3, 4, 3, 4, 4, 2, 3, 4, 5, 4, 3, 4, 4, 5, 4, 3] },
  { span: 179, days: 57, mood: [4, 3, 4, 5, 4, 4, 3, 2, 3, 4, 5, 5, 4, 4, 4, 3] },
];
const W = 560, H = 210, L = 6, R = 96, T = 10, B = 30;
const x = (k: number) => L + (k / 15) * (W - L - R);
const y = (m: number) => T + ((5 - m) / 4) * (H - T - B);

// Monotone cubic (Fritsch–Carlson), like Swift Charts' .monotone.
function monotone(p: [number, number][]) {
  const n = p.length, dx: number[] = [], m: number[] = [], tan: number[] = [];
  for (let i = 0; i < n - 1; i++) { dx[i] = p[i + 1][0] - p[i][0]; m[i] = (p[i + 1][1] - p[i][1]) / dx[i]; }
  tan[0] = m[0]; tan[n - 1] = m[n - 2];
  for (let i = 1; i < n - 1; i++) tan[i] = m[i - 1] * m[i] <= 0 ? 0 : (3 * (dx[i - 1] + dx[i])) / ((2 * dx[i] + dx[i - 1]) / m[i - 1] + (dx[i] + 2 * dx[i - 1]) / m[i]);
  let d = `M${p[0][0].toFixed(1)},${p[0][1].toFixed(1)}`;
  for (let i = 0; i < n - 1; i++) {
    const h = dx[i] / 3;
    d += ` C${(p[i][0] + h).toFixed(1)},${(p[i][1] + h * tan[i]).toFixed(1)} ${(p[i + 1][0] - h).toFixed(1)},${(p[i + 1][1] - h * tan[i + 1]).toFixed(1)} ${p[i + 1][0].toFixed(1)},${p[i + 1][1].toFixed(1)}`;
  }
  return d;
}
const base = y(0.6);
const charts = frames.map((f) => {
  const pts = f.mood.map((m, k) => [x(k), y(m)] as [number, number]);
  const line = monotone(pts);
  const counts = [1, 2, 3, 4, 5].map((v) => f.mood.filter((m) => m === v).length);
  const top = counts.lastIndexOf(Math.max(...counts));
  return {
    ...f, pts, line,
    area: `${line} L${pts.at(-1)![0].toFixed(1)},${base} L${pts[0][0].toFixed(1)},${base} Z`,
    summary: levels[top],
    ago: f.mood.map((_, k) => Math.round(f.span - (k / 15) * f.span)),
  };
});

// Rhythm: 12 weeks x 7 days, Monday first; Tuesdays busiest. Deterministic example data.
let seed = 7;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const grid = Array.from({ length: 12 }, (_, w) =>
  Array.from({ length: 7 }, (_, d) => {
    if (w === 11 && d > 1) return -1;
    const r = rand() + (d === 1 ? 0.45 : 0) - (d >= 5 ? 0.15 : 0);
    return r > 1.05 ? 2 : r > 0.55 ? 1 : 0;
  }),
);
const weekdayTotals = t.days.map((_, d) => grid.reduce((s, w) => s + Math.max(0, w[d]), 0));
const peakDay = weekdayTotals.indexOf(Math.max(...weekdayTotals));

// Why: top reason teak, the rest ink at falling opacity (25% minimum). Usual mood per reason.
const counts = [5, 4, 3, 2, 2];
const usual = [2, 4, 3, 2, 1];
const total = counts.reduce((a, b) => a + b, 0);
const opac = [1, 0.8, 0.6, 0.4, 0.25];
const arc = (a0: number, a1: number, r0: number, r1: number) => {
  const p = (a: number, r: number) => `${(68 + r * Math.sin(a)).toFixed(2)},${(68 - r * Math.cos(a)).toFixed(2)}`;
  const big = a1 - a0 > Math.PI ? 1 : 0;
  return `M${p(a0, r1)} A${r1},${r1} 0 ${big} 1 ${p(a1, r1)} L${p(a1, r0)} A${r0},${r0} 0 ${big} 0 ${p(a0, r0)} Z`;
};
let acc = 0;
const slices = counts.map((c, i) => {
  const a0 = (acc / total) * Math.PI * 2 + 0.015, a1 = ((acc + c) / total) * Math.PI * 2 - 0.015;
  const mid = (a0 + a1) / 2;
  acc += c;
  return { d: arc(a0, a1, 42, 66), o: opac[i], dx: (4 * Math.sin(mid)).toFixed(2), dy: (-4 * Math.cos(mid)).toFixed(2) };
});
const stats = [{ n: 57, icon: 'notebook' }, { n: 5, icon: 'calendarDots' }, { n: 4, icon: 'calendarCheck' }] as const;
---
<div class="insights" data-insights data-locale={locales[lang]}>
  <p class="sr-only">{label}</p>

  <div class="stats" aria-hidden="true">
    {stats.map((s, i) => (
      <div class="stat">
        <Icon name={s.icon} size={22} />
        <span class="num" data-count={s.n}>{s.n}</span>
        <span class="label">{t.stats[i]}</span>
      </div>
    ))}
  </div>

  <div class="panel mood" data-frame="0">
    <p class="label">{t.mood}</p>
    <div class="frames" role="group" aria-label={t.mood}>
      {t.frames.map((f, i) => <button type="button" class="label frame" data-pick-frame={i} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>)}
    </div>
    <div class="summaries">
      {charts.map((c, i) => <p class="summary" data-f={i}><span>{t.mostly} {c.summary}</span> {t.across(c.days)}</p>)}
    </div>
    <div class="chart-wrap">
      <svg class="chart" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <defs>
          <linearGradient id={`wash-${lang}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--teak)" stop-opacity="0.22" />
            <stop offset="1" stop-color="var(--teak)" stop-opacity="0" />
          </linearGradient>
        </defs>
        {[...levels].reverse().map((lv, i) => <text class="axis" x={W - R + 12} y={y(5 - i) + 4}>{lv.toUpperCase()}</text>)}
        <line class="neutral" x1={L} x2={W - R} y1={y(3)} y2={y(3)} />
        <line class="cursor" x1="0" x2="0" y1={T} y2={H - B} data-cursor />
        {charts.map((c, i) => (
          <g class="series" data-f={i}>
            <path class="wash" d={c.area} fill={`url(#wash-${lang})`} />
            <path class="line" d={c.line} pathLength="1" />
            {c.pts.map(([px, py], k) => (
              <circle class:list={['pt', { latest: k === 15 }]} cx={px} cy={py} r={k === 15 ? 5.5 : 3.5}
                data-ago={c.ago[k]} data-mood={c.mood[k] - 1} />
            ))}
          </g>
        ))}
        {[0, 1, 2].map((k) => <text class="axis date" data-axis={k} x={[L, (L + W - R) / 2, W - R][k]} y={H - 6} text-anchor={['start', 'middle', 'end'][k]}></text>)}
      </svg>
      <p class="tip label" data-tip hidden></p>
    </div>
    <p class="footer label" aria-hidden="true">
      <span>{t.first} <span data-ago-label="179"></span></span><span>{t.last} <span data-ago-label="0"></span></span><span>{t.journaling}</span>
    </p>
  </div>

  <div class="panel rhythm" aria-hidden="true">
    <p class="label">{t.rhythm}</p>
    <div class="grid">
      {t.days.map((d, di) => (
        <>
          <span class:list={['day', 'label', { peak: di === peakDay }]}>{d}</span>
          {grid.map((week, wi) => (
            <i class:list={['cell', `c${week[di]}`, { today: wi === 11 && di === 1 }]} style={`--n: ${wi * 7 + di}`}></i>
          ))}
        </>
      ))}
    </div>
    <p class="peakline">{t.peak}</p>
  </div>

  <div class="panel why">
    <p class="label">{t.why}</p>
    <div class="why-body">
      <div class="doughnut-wrap">
        <svg viewBox="0 0 136 136" class="doughnut" aria-hidden="true">
          {slices.map((s, i) => <path d={s.d} class:list={{ top: i === 0 }} data-slice={i} style={`--o: ${s.o}; --i: ${i}; --dx: ${s.dx}px; --dy: ${s.dy}px`} />)}
        </svg>
        <div class="hole" aria-hidden="true">
          {t.reasons.map((r, i) => (
            <span class="hole-text" data-r={i}><span class="label">{r}</span><span class="share">{Math.round((counts[i] / total) * 100)}%</span></span>
          ))}
        </div>
      </div>
      <ul>
        {t.reasons.map((r, i) => (
          <li><button type="button" data-pick-reason={i} aria-pressed="false">
            <i style={`--o: ${opac[i]}`} class:list={{ top: i === 0 }}></i>{r}<span>{counts[i]}</span>
          </button></li>
        ))}
      </ul>
    </div>
    <div class="usual">
      {t.reasons.map((_, i) => <p class="usual-line" data-r={i}><i></i>{t.usually} {levels[usual[i]]}</p>)}
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-insights]');
  if (root) {
    const locale = root.dataset.locale ?? 'en-GB';
    const short = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' });
    // App style: 11 SEP (three-letter month, whatever the browser's short form is).
    const fmt = (ago: number) => {
      const d = new Date();
      d.setDate(d.getDate() - ago);
      const p = short.formatToParts(d);
      const get = (k: string) => p.find((x) => x.type === k)?.value ?? '';
      return `${get('day')} ${get('month').replace('.', '').slice(0, 3)}`.toUpperCase();
    };
    const mood = root.querySelector<HTMLElement>('.mood')!;
    const levels = [...root.querySelectorAll<SVGTextElement>('.axis:not(.date)')].map((n) => n.textContent ?? '').reverse();

    // Timeframe chips: the line redraws for 30 days, 90 days or all time.
    const setFrame = (f: number) => {
      mood.dataset.frame = String(f);
      root.querySelectorAll<HTMLButtonElement>('[data-pick-frame]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pickFrame === String(f))));
      const line = root.querySelector<SVGPathElement>(`.series[data-f="${f}"] .line`);
      if (line) { line.style.animation = 'none'; void line.getBoundingClientRect(); line.style.animation = ''; }
      const pts = [...root.querySelectorAll<SVGCircleElement>(`.series[data-f="${f}"] .pt`)];
      [0, 7, 15].forEach((k, n) => {
        const el = root.querySelector(`[data-axis="${n}"]`);
        if (el) el.textContent = fmt(Number(pts[k].dataset.ago));
      });
      hideTip();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-pick-frame]').forEach((b) => b.addEventListener('click', () => setFrame(Number(b.dataset.pickFrame))));

    // A point shows its day and mood, with a dashed rule through it.
    const tip = root.querySelector<HTMLElement>('[data-tip]')!;
    const cursor = root.querySelector<SVGLineElement>('[data-cursor]')!;
    const hideTip = () => { tip.hidden = true; cursor.classList.remove('on'); };
    root.querySelectorAll<SVGCircleElement>('.pt').forEach((pt) => {
      const showTip = () => {
        const svg = pt.ownerSVGElement!;
        const box = svg.getBoundingClientRect();
        const k = box.width / svg.viewBox.baseVal.width;
        const cx = Number(pt.getAttribute('cx')), cy = Number(pt.getAttribute('cy'));
        tip.textContent = `${fmt(Number(pt.dataset.ago))} · ${levels[Number(pt.dataset.mood)]}`;
        tip.style.left = `${cx * k}px`;
        tip.style.top = `${cy * k}px`;
        tip.hidden = false;
        cursor.setAttribute('x1', String(cx)); cursor.setAttribute('x2', String(cx));
        cursor.classList.add('on');
      };
      pt.addEventListener('pointerenter', showTip);
      pt.addEventListener('click', showTip);
    });
    root.querySelector('.chart')?.addEventListener('pointerleave', hideTip);

    // Why: pick a reason (row or slice) to see its share and its usual mood; pick again to let go.
    const why = root.querySelector<HTMLElement>('.why')!;
    const pick = (r: string | null) => {
      if (r === null || why.dataset.picked === r) delete why.dataset.picked;
      else why.dataset.picked = r;
      root.querySelectorAll<HTMLButtonElement>('[data-pick-reason]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pickReason === why.dataset.picked)));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-pick-reason]').forEach((b) => b.addEventListener('click', () => pick(b.dataset.pickReason!)));
    root.querySelectorAll<SVGPathElement>('[data-slice]').forEach((s) => s.addEventListener('click', () => pick(s.dataset.slice!)));
    root.querySelector('.hole')?.addEventListener('click', () => pick(null));

    setFrame(0);
    root.querySelectorAll<HTMLElement>('[data-ago-label]').forEach((el) => { el.textContent = fmt(Number(el.dataset.agoLabel)); });

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      root.classList.add('waiting');
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        root.classList.replace('waiting', 'drawn');
        for (const el of root.querySelectorAll<HTMLElement>('[data-count]')) {
          const end = Number(el.dataset.count), t0 = performance.now();
          const tick = (now: number) => {
            const k = Math.min(1, (now - t0) / 900);
            el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.3 });
      io.observe(root);
    }
  }
</script>

<style>
  .insights { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 52rem) {
    .insights {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      grid-template-areas: 'stats rhythm' 'mood rhythm' 'mood why';
      align-items: stretch;
    }
    .stats { grid-area: stats; } .mood { grid-area: mood; } .rhythm { grid-area: rhythm; } .why { grid-area: why; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  p { margin: 0; }
  .label { color: var(--ink-2); }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }

  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .stat { display: grid; gap: 0.5rem; align-content: start; padding: 1rem; background: var(--paper-raised); border-radius: 2px; color: var(--ink-2); }
  .num { font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem); line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat .label { line-height: 1.3; }

  .panel { padding: 1.25rem; background: var(--paper-raised); border-radius: 2px; }
  .mood { display: flex; flex-direction: column; }
  /* Insights' numeric footer: first entry, last entry, days journaling. */
  .footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1rem; margin-top: auto; padding-top: 1.25rem; font-size: 0.625rem; color: var(--ink-2); }
  .panel > .label { margin-bottom: 0.875rem; }
  .frames { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 1rem; }
  .frame { min-height: 2.25rem; padding: 0 0.625rem; border: var(--hairline) solid var(--rule); border-radius: 2px; font-size: 0.6875rem; transition: background-color 200ms ease-out, border-color 200ms ease-out, color 200ms ease-out; }
  .frame:hover { color: var(--ink); }
  .frame[aria-pressed='true'] { background: var(--paper); color: var(--ink); border-color: var(--teak); }
  .summaries { display: grid; margin-bottom: 0.75rem; }
  .summary { grid-area: 1 / 1; font-size: 0.9375rem; color: var(--ink-2); opacity: 0; transition: opacity 200ms ease-out; }
  .summary span { font-size: 1.375rem; font-weight: 500; color: var(--ink); }
  .mood[data-frame='0'] .summary[data-f='0'], .mood[data-frame='1'] .summary[data-f='1'], .mood[data-frame='2'] .summary[data-f='2'] { opacity: 1; }

  .chart-wrap { position: relative; }
  .chart { width: 100%; height: auto; overflow: visible; display: block; }
  .axis { font: 500 12px var(--mono); letter-spacing: 0.08em; fill: var(--ink-3); }
  .neutral { stroke: var(--ink-3); stroke-width: 0.5; stroke-dasharray: 4 4; }
  .cursor { stroke: var(--ink-3); stroke-width: 0.5; stroke-dasharray: 2 3; opacity: 0; }
  .cursor.on { opacity: 1; }
  .series { opacity: 0; pointer-events: none; transition: opacity 320ms ease-out; }
  .mood[data-frame='0'] .series[data-f='0'], .mood[data-frame='1'] .series[data-f='1'], .mood[data-frame='2'] .series[data-f='2'] { opacity: 1; pointer-events: auto; }
  .line { fill: none; stroke: var(--teak); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pt { fill: var(--teak); cursor: pointer; transition: r 200ms ease-out; }
  .pt:hover { r: 6; }
  .pt.latest { fill: var(--paper); stroke: var(--teak); stroke-width: 2.5; }
  /* Re-drawing the line when the timeframe changes */
  .mood[data-frame] .series .line { stroke-dasharray: 1; animation: draw 900ms var(--ease) both; }
  .tip {
    position: absolute; translate: -50% calc(-100% - 12px);
    padding: 0.4rem 0.55rem; white-space: nowrap; font-size: 0.6875rem; color: var(--ink);
    background: var(--paper-raised); border: var(--hairline) solid var(--rule); border-radius: 2px;
    box-shadow: 0 2px 8px rgba(26, 22, 20, 0.15); pointer-events: none;
  }

  .grid { display: grid; grid-template-columns: 1rem repeat(12, minmax(0, 1fr)); gap: 3px; align-items: center; }
  .day { font-size: 0.625rem; color: var(--ink-3); }
  .day.peak { color: var(--teak); }
  .cell { aspect-ratio: 1; border-radius: 2px; background: color-mix(in srgb, var(--rule) 60%, transparent); }
  .cell.c1 { background: color-mix(in srgb, var(--teak) 55%, transparent); }
  .cell.c2 { background: var(--teak); }
  .cell.c-1 { background: transparent; }
  .cell.today { box-shadow: inset 0 0 0 1px var(--ink); }
  .peakline { font-size: 0.9375rem; color: var(--ink-2); margin-top: 0.875rem; }

  .why-body { display: flex; align-items: center; gap: 1.25rem; }
  .doughnut-wrap { position: relative; width: 8rem; flex: none; }
  .doughnut { width: 100%; display: block; overflow: visible; }
  .doughnut path { fill: var(--ink); opacity: var(--o); cursor: pointer; transition: opacity 200ms ease-out, translate 260ms var(--ease); }
  .doughnut path.top { fill: var(--teak); opacity: 1; }
  .hole { position: absolute; inset: 31%; display: grid; place-items: center; text-align: center; border-radius: 50%; cursor: pointer; }
  .hole-text { grid-area: 1 / 1; display: grid; gap: 0.1rem; opacity: 0; transition: opacity 200ms ease-out; }
  .hole-text .label { font-size: 0.5625rem; line-height: 1.1; }
  .share { font-size: 1.25rem; line-height: 1; }
  ul { list-style: none; margin: 0; padding: 0; flex: 1; font-size: 0.9375rem; min-width: 0; }
  li button { display: flex; width: 100%; align-items: center; gap: 0.5rem; min-height: 1.9rem; text-align: left; }
  li i { flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--ink); opacity: var(--o); }
  li i.top { background: var(--teak); opacity: 1; }
  li span { margin-left: auto; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  li button[aria-pressed='true'] { font-weight: 600; }
  .usual { display: grid; }
  .usual-line { grid-area: 1 / 1; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.875rem; font-size: 0.9375rem; color: var(--ink-2); opacity: 0; transition: opacity 200ms ease-out; }
  .usual-line i { width: 6px; height: 6px; border-radius: 50%; background: var(--teak); }
  /* A picked reason: its slice steps out, the rest fade, the hole and the usual mood show it. */
  .why[data-picked] .doughnut path { opacity: calc(var(--o) * 0.3); }
  .why[data-picked] .doughnut path.top { opacity: 0.3; }
  .why[data-picked='0'] [data-slice='0'], .why[data-picked='1'] [data-slice='1'], .why[data-picked='2'] [data-slice='2'],
  .why[data-picked='3'] [data-slice='3'], .why[data-picked='4'] [data-slice='4'] { opacity: max(var(--o), 0.6); translate: var(--dx) var(--dy); }
  .why[data-picked='0'] [data-slice='0'] { opacity: 1; }
  .why[data-picked='0'] [data-r='0'], .why[data-picked='1'] [data-r='1'], .why[data-picked='2'] [data-r='2'],
  .why[data-picked='3'] [data-r='3'], .why[data-picked='4'] [data-r='4'] { opacity: 1; }

  /* Draw-in, only when the script is waiting for the panel to appear. */
  .waiting .line { stroke-dashoffset: 1; animation: none; }
  .waiting .wash, .waiting .pt { opacity: 0; }
