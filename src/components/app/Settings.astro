---
// "Also in Oku" as the app's own Settings screen. Theme and Language really work on this page;
// the reminder and lock toggles are a demo. Row text is the app's strings and STORE.md's list.
import { href, type Lang, type Page } from '../../i18n';

interface Props { lang: Lang; page?: Page }
const { lang, page = '' } = Astro.props;

const t = {
  en: {
    appearance: 'Appearance', theme: 'Theme', themes: ['System', 'Light', 'Dark'], icon: 'App icon',
    language: 'Language', languageNote: 'English and Indonesian, each written for its own language.',
    notifications: 'Notifications', reminder: 'Daily reminder', time: 'Time', at: '21.00',
    lock: 'Lock', faceId: 'Lock with Face ID',
    lockHint: 'Asks when Oku opens, and after a minute away. Your iPhone passcode works if Face ID doesn’t.',
    more: 'Also',
    rows: ['Voice notes, turned into text on your iPhone (English)', 'Recently Deleted keeps entries for 30 days'],
  },
  id: {
    appearance: 'Tampilan', theme: 'Tema', themes: ['Sistem', 'Terang', 'Gelap'], icon: 'Ikon aplikasi',
    language: 'Bahasa', languageNote: 'Bahasa Indonesia dan Inggris, masing-masing ditulis untuk bahasanya sendiri.',
    notifications: 'Notifikasi', reminder: 'Pengingat harian', time: 'Waktu', at: '21.00',
    lock: 'Kunci', faceId: 'Kunci dengan Face ID',
    lockHint: 'Ditanya saat Oku dibuka, dan setelah ditinggal semenit. Kode sandi iPhone-mu bisa dipakai kalau Face ID gagal.',
    more: 'Juga',
    rows: ['Baru Dihapus menyimpan catatan selama 30 hari'],
  },
}[lang];
const themeValues = ['system', 'light', 'dark'];
---
<div class="settings" data-settings>
  <p class="label head">{t.appearance}</p>
  <div class="card">
    <div class="row">
      <span>{t.theme}</span>
      <div class="segmented" role="group" aria-label={t.theme}>
        {t.themes.map((name, i) => (
          <button type="button" class="label" data-theme-pick={themeValues[i]} aria-pressed={i === 0 ? 'true' : 'false'}>{name}</button>
        ))}
      </div>
    </div>
    <div class="row">
      <span>{t.icon}</span>
      <span class="icons" aria-hidden="true">
        <i class="app mark"><b></b></i>
        <i class="app word">Oku</i>
        <i class="app kanji">奥</i>
      </span>
    </div>
  </div>

  <p class="label head">{t.language}</p>
  <div class="card">
    <div class="row">
      <span class="segmented wide" role="group" aria-label={t.language}>
        <a class="label" href={href('en', page)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
        <a class="label" href={href('id', page)} hreflang="id" lang="id" aria-current={lang === 'id' ? 'true' : undefined}>Indonesia</a>
      </span>
    </div>
  </div>
  <p class="foot">{t.languageNote}</p>

  <p class="label head">{t.notifications}</p>
  <div class="card">
    <label class="row">
      <span>{t.reminder}</span>
      <input type="checkbox" class="toggle" data-reminder />
    </label>
    <div class="row time" data-time hidden>
      <span>{t.time}</span><span class="value">{t.at}</span>
    </div>
  </div>

  <p class="label head">{t.lock}</p>
  <div class="card">
    <label class="row">
      <span>{t.faceId}</span>
      <input type="checkbox" class="toggle" />
    </label>
  </div>
  <p class="foot">{t.lockHint}</p>

  <p class="label head">{t.more}</p>
  <div class="card">
    {t.rows.map((r) => <div class="row"><span>{r}</span></div>)}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-settings]');
  if (root) {
    // Theme: a per-viewer choice, kept in this browser if storage allows.
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-theme-pick]')];
    const apply = (value: string) => {
      if (value === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = value;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themePick === value)));
      try { value === 'system' ? localStorage.removeItem('oku-theme') : localStorage.setItem('oku-theme', value); } catch {}
    };
    let saved = 'system';
    try { saved = localStorage.getItem('oku-theme') ?? 'system'; } catch {}
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themePick === saved)));
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.themePick!)));

    // The reminder's time row appears when it is on, as in the app.
    const reminder = root.querySelector<HTMLInputElement>('[data-reminder]');
    const time = root.querySelector<HTMLElement>('[data-time]');
    reminder?.addEventListener('change', () => { if (time) time.hidden = !reminder.checked; });
  }
</script>

<style>
  .settings { max-width: 34rem; margin: 0 auto; }
  .head { color: var(--ink-3); margin: 1.75rem 0 0.5rem; padding-left: 1rem; letter-spacing: 0.06em; }
  .head:first-child { margin-top: 0; }
  /* DESIGN.md Settings card: Raised Paper, 4px radius, rows split by 0.5pt rules */
  .card { background: var(--paper-raised); border-radius: 4px; padding: 0 1rem; }
  .row {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 3.25rem; padding: 0.75rem 0;
    border-bottom: var(--hairline) solid var(--rule);
  }
  .row:last-child { border-bottom: 0; }
  .row[hidden] { display: none; }
  label.row { cursor: pointer; }
  .value { color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .foot { font-size: 0.875rem; color: var(--ink-2); margin: 0.5rem 1rem 0; }

  /* DESIGN.md segmented control */
  .segmented { display: inline-flex; gap: 2px; padding: 4px; background: var(--paper-sunken); border-radius: 4px; }
  .segmented.wide { width: 100%; }
  .segmented.wide > * { flex: 1; }
  .segmented button, .segmented a {
    appearance: none; border: 0; background: transparent; cursor: pointer;
    min-height: 2.25rem; padding: 0 0.75rem;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--ink-3); text-decoration: none; border-radius: 2px;
    transition: background-color 200ms ease-out, color 200ms ease-out;
  }
  .segmented button:hover, .segmented a:hover { color: var(--ink); }
  .segmented [aria-pressed='true'], .segmented [aria-current='true'] { background: var(--paper); color: var(--ink); box-shadow: 0 1px 2px rgba(26, 22, 20, 0.08); }

  /* A switch drawn in ink: on is Ink 2, as in the app's Settings. */
  .toggle {
    appearance: none; flex: none; margin: 0; cursor: pointer;
    width: 3.1875rem; height: 1.9375rem; border-radius: 999px;
    background: var(--rule); position: relative;
    transition: background-color 200ms ease-out;
  }
  .toggle::after {
    content: ''; position: absolute; top: 2px; left: 2px;
    width: 1.6875rem; height: 1.6875rem; border-radius: 50%;
    background: #FEFCF6; box-shadow: 0 1px 3px rgba(26, 22, 20, 0.25);
    transition: translate 260ms var(--ease);
  }
  .toggle:checked { background: var(--ink-2); }
  .toggle:checked::after { translate: 1.25rem 0; }
  .toggle:focus-visible { outline: 1px solid var(--ink); outline-offset: 3px; }

  /* The three app icons, drawn (light variants: #DED5C0 ground, ink figure). */
  .icons { display: inline-flex; gap: 0.5rem; }
  .app {
    width: 2.25rem; height: 2.25rem; border-radius: 0.5rem;
    display: grid; place-items: center;
    background: #DED5C0; color: #1A1614; font-style: normal;
    box-shadow: 0 0 0 0.5px rgba(26, 22, 20, 0.15);
  }
  .app.mark b { width: 1.25rem; height: 1.25rem; border-radius: 50%; border: 1.5px solid #1A1614; display: grid; place-items: center; }
  .app.mark b::after { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: #1A1614; }
  .app.word { font-family: var(--serif); font-size: 0.8125rem; }
  .app.kanji { font-family: var(--serif); font-size: 1.125rem; }
</style>
