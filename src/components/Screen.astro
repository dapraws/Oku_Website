---
// One raw app screen: no device frame, the iPhone's display corners, a hairline edge.
// Dark captures (<name>-dark.webp) are used in dark mode, toggle included, when they exist.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n';

interface Props { lang: Lang; name: string; alt: string; eager?: boolean; class?: string }
const { lang, name, alt, eager = false, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*/*.webp', { eager: true });
const pick = (n: string) => files[`../assets/screens/${lang}/${n}.webp`]?.default;
const light = pick(name);
if (!light) throw new Error(`missing screen ${lang}/${name}`);
const dark = pick(`${name}-dark`);

const widths = [320, 480, 660, 900];
const srcset = async (src: ImageMetadata) => {
  const out = await Promise.all(widths.map((w) => getImage({ src, width: w, format: 'webp', quality: 82 })));
  return out.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
};
const sizes = '(min-width: 64rem) 18rem, (min-width: 40rem) 40vw, 72vw';
const shots = [{ src: light, mode: 'light' }, ...(dark ? [{ src: dark, mode: 'dark' }] : [])];
const imgs = await Promise.all(shots.map(async ({ src, mode }) => ({
  mode, src, srcset: await srcset(src),
  fallback: (await getImage({ src, width: 660, format: 'webp', quality: 82 })).src,
})));
---
<span class:list={['screen', className, { paired: dark }]}>
  {imgs.map((img) => (
    <img class={img.mode} src={img.fallback} srcset={img.srcset} sizes={sizes}
      width={img.src.width} height={img.src.height} alt={img.mode === 'dark' ? '' : alt}
      loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ))}
</span>

<style>
  .screen { display: block; }
  /* A paired screen shows one capture per theme; hidden lazy images never load. */
  .paired .dark { display: none; }
  :global(:root[data-theme='dark']) .paired .light { display: none; }
  :global(:root[data-theme='dark']) .paired .dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .paired .light { display: none; }
    :global(:root:not([data-theme='light'])) .paired .dark { display: block; }
  }
  .screen img {
    display: block;
    width: 100%;
    /* iPhone 17 Pro Max: ~55pt display corners on a 440 x 956pt screen */
    border-radius: 12.5% / 5.75%;
    box-shadow: 0 0 0 var(--hairline) var(--rule), var(--shadow-print);
    background: var(--paper-sunken);
  }
</style>
