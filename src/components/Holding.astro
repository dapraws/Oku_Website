---
// Stands in for the landing page until it is built. Copy from STORE.md only.
import Mark from './Mark.astro';
import { chrome, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const promo = {
  en: 'Write a line or a page. Oku keeps it on your iPhone.',
  id: 'Tulis satu baris atau satu halaman. Oku menyimpannya di iPhone-mu.',
}[lang];
---
<section class="holding">
  <Mark size={96} class="mark" />
  <h1 class="bloom">Oku</h1>
  <p class="tagline">{chrome[lang].tagline}</p>
  <p class="promo">{promo}</p>
</section>

<style>
  .holding {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(3rem, 12vh, 8rem);
  }
  .mark { color: var(--ink); margin-bottom: 1.5rem; }
  h1 { font-size: clamp(3rem, 2rem + 4vw, 4.5rem); font-weight: 400; line-height: 1; margin: 0 0 1rem; }
  .tagline { font-size: 1.375rem; margin: 0 0 0.5rem; }
  .promo { color: var(--ink-2); margin: 0; max-width: 28rem; text-wrap: balance; }
</style>
