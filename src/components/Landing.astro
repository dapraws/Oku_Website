---
// The landing page, "Inward". The hero writes a few days, the page looks back on them (each tied to
// its pin on the map), Insights can be tried, pieces of the app float around the writing features,
// and every ring is centred on the ink dot that holds privacy. One real screen (the map) is proof.
// Copy: STORE.md, plus lines approved with Darrel (2026-10-07, 2026-10-10).
import Phone from './Phone.astro';
import ComposeSheet from './app/ComposeSheet.astro';
import EntryRow from './app/EntryRow.astro';
import Insights from './app/Insights.astro';
import Painting from './app/Painting.astro';
import Features from './app/Features.astro';
import AppStoreBadge from './AppStoreBadge.astro';
import { entries, moods, locales } from '../entries';
import { chrome, href, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  en: {
    headline: 'A quiet place for *your days.*',
    lead: 'Write about your day. Everything you write stays with you.',
    kanji: 'Named from Japanese 奥 — the inner, hidden interior of a place.',
    write: {
      title: 'Write a line *or a page.*',
      body: 'Mark how the day felt in one word, from Heavy to Bright, and pick up to three reasons why. Add the place, the people who were there, and a few photos, which Oku keeps as polaroids. If you don’t know how to start, borrow a line and keep going. Missed a day? Write it under its own date.',
    },
    back: {
      title: 'See where your days *happened.*',
      body: 'Home shows today and, when there is one, an entry from this day in an earlier year. Stories lays your entries out on a map, on a timeline, and by the people in them.',
      mapAlt: 'Stories, Map: entries pinned across Java and Bali, with the places listed below.',
      onThisDay: 'a year ago today', entries: 'entries',
      year: { place: 'Semarang', title: 'Moving day', body: 'Boxes everywhere. Ate noodles on the floor because the table hadn’t come yet.', mood: 3 },
    },
    felt: {
      title: 'Notice how your days *have felt.*',
      body: 'Insights shows how your days have felt over time, when you tend to write, and what your days were about, without scores or advice.',
      note: 'no scores, no streaks',
      label: 'Insights, with example entries: 57 entries, mostly Good over the last 30 days, written most often on Tuesdays, and Self as the most common reason.',
    },
    private: {
      title: 'It stays on *your iPhone.*',
      body: 'No account. No ads, no analytics, no tracking. Title suggestions, a gentle polish of what you wrote, and photo captions come from Apple’s on-device models, so your words are not sent anywhere. iCloud sync is off until you turn it on, and then your entries go to your own private iCloud.',
      maps: 'Looking up a place uses Apple Maps.',
      link: 'Read the privacy policy',
    },
    also: { note: 'AI features need a device that supports Apple Intelligence.' },
  },
  id: {
    headline: 'Ruang tenang untuk *harimu.*',
    lead: 'Tulis tentang harimu. Semua yang kamu tulis tetap bersamamu.',
    kanji: 'Diambil dari kanji 奥 — bagian dalam sebuah tempat yang tersembunyi.',
    write: {
      title: 'Satu baris *atau satu halaman.*',
      body: 'Tandai perasaanmu hari itu dengan satu kata, dari Berat sampai Cerah, lalu pilih sampai tiga alasannya. Tambahkan tempat, orang-orang yang ada di sana, dan beberapa foto yang disimpan Oku sebagai polaroid. Bingung mulai dari mana? Pinjam satu kalimat, lalu lanjutkan. Ada hari yang terlewat? Tulis di tanggalnya sendiri.',
    },
    back: {
      title: 'Lihat di mana harimu *terjadi.*',
      body: 'Beranda menampilkan hari ini dan, kalau ada, catatan dari tanggal yang sama di tahun sebelumnya. Ceritaku menata catatanmu di peta, di riwayat, dan menurut orang-orang di dalamnya.',
      mapAlt: 'Ceritaku, Peta: catatan tersebar di Jawa dan Bali, dengan daftar tempat di bawahnya.',
      onThisDay: 'setahun lalu hari ini', entries: 'catatan',
      year: { place: 'Semarang', title: 'Hari pindahan', body: 'Kardus di mana-mana. Makan mi di lantai karena mejanya belum datang.', mood: 3 },
    },
    felt: {
      title: 'Lihat bagaimana harimu *terasa.*',
      body: 'Ringkasan menunjukkan perasaanmu dari waktu ke waktu, kapan kamu biasa menulis, dan apa yang mengisi hari-harimu, tanpa skor atau nasihat.',
      note: 'tanpa skor, tanpa streak',
      label: 'Ringkasan dengan catatan contoh: 57 catatan, kebanyakan Baik selama 30 hari terakhir, paling sering menulis di hari Selasa, dan Diri sendiri sebagai alasan terbanyak.',
    },
    private: {
      title: 'Tetap di *iPhone-mu.*',
      body: 'Tanpa akun. Tanpa iklan, analitik, atau pelacakan. Saran judul, perapian tulisan, dan keterangan foto dibuat oleh model Apple di perangkatmu, jadi tulisanmu tidak dikirim ke mana pun. Sinkronisasi iCloud mati sampai kamu menyalakannya, lalu catatanmu masuk ke iCloud pribadimu sendiri.',
      maps: 'Mencari tempat memakai Apple Maps.',
      link: 'Baca kebijakan privasi',
    },
    also: { note: 'Fitur AI membutuhkan perangkat yang mendukung Apple Intelligence.' },
  },
}[lang];

// One italic phrase per heading, marked *like this* in the copy above.
const em = (text: string) => text.replace(/\*(.+?)\*/g, '<em>$1</em>');
// The hero headline blooms word by word; words inside *...* stay italic.
let inEm = false;
const words = copy.headline.split(' ').map((raw) => {
  const opens = raw.startsWith('*');
  const closes = raw.endsWith('*') || raw.endsWith('*.');
  const text = raw.replace(/\*/g, '');
  const italic = inEm || opens;
  if (opens) inEm = true;
  if (closes) inEm = false;
  return { text, italic };
});
const list = entries[lang];
const year = new Date().getFullYear();
---
<div class="inward" data-inward>
  <svg class="rings" aria-hidden="true" data-rings></svg>

  <section class="hero" data-ring>
    <div class="hero-text">
      <h1>
        {words.map((w, i) => <span class:list={['word', { em: w.italic }]} style={`animation-delay: ${120 + i * 110}ms`}>{w.text}</span>)}
      </h1>
      <p class="lead">{copy.lead}</p>
      <p class="kanji">{copy.kanji}</p>
      <AppStoreBadge lang={lang} class="hero-badge" />
    </div>
    <div class="hero-sheet">
      <ComposeSheet lang={lang} />
    </div>
  </section>


  <section class="back" data-ring>
    <div class="back-text">
      <h2 set:html={em(copy.back.title)} />
      <p>{copy.back.body}</p>
    </div>
    <div class="back-art" data-back>
      <Phone lang={lang} name="04-map" alt={copy.back.mapAlt} class="map" />
      <svg class="links" aria-hidden="true" data-links></svg>
      <div class="slips" aria-hidden="true">
        <!-- On This Day: Teak Wash, as on Home. The year rolls back when it comes into view. -->
        <div class="slip otd" data-locale={locales[lang]}>
          <p class="label otd-label">
            <span>{copy.back.onThisDay}</span>
            <span class="otd-date"><span data-otd-day></span> <span class="year"><span class="roll"><span>{year}</span><span>{year - 1}</span></span></span></span>
          </p>
          <div class="otd-row">
            <div class="thumb"><Painting scene="night" seed={4} /></div>
            <div>
              <p class="otd-meta label">{copy.back.year.place}</p>
              <p class="otd-title">{copy.back.year.title}</p>
              <p class="otd-body">{copy.back.year.body}</p>
              <p class="otd-mood"><i></i>{moods[lang][copy.back.year.mood]}</p>
            </div>
          </div>
        </div>
        <div class="slip rows">
          <p class="label rows-head">{copy.back.entries}</p>
          {list.map((e, i) => (
            <div class="deal" style={`--d: ${i}`} data-pin={e.place}>
              <EntryRow scene={e.scene} daysAgo={e.daysAgo} place={e.place} meta={e.place}
                title={e.title} excerpt={e.body} mood={moods[lang][e.mood]} person={e.person} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="felt" data-ring>
    <div class="felt-text">
      <h2 set:html={em(copy.felt.title)} />
      <p>{copy.felt.body}</p>
      <p class="note" aria-hidden="true">{copy.felt.note}</p>
    </div>
    <Insights lang={lang} label={copy.felt.label} />
  </section>

  <section class="features" data-ring>
    <Features lang={lang} title={em(copy.write.title)} note={copy.also.note} />
  </section>

  <section class="dot-wrap">
    <div class="dot" data-dot>
      <div class="dot-text">
        <h2 set:html={em(copy.private.title)} />
        <p>{copy.private.body} {copy.private.maps}</p>
        <p><a href={href(lang, 'privacy')}>{copy.private.link}</a></p>
      </div>
    </div>
  </section>

  <section class="closing">
    <p class="closing-word">Oku</p>
    <p class="closing-line">{chrome[lang].tagline}</p>
    <AppStoreBadge lang={lang} />
  </section>

</div>

<script>
  // Rings: one hairline circle per section, all centred on the ink dot. As the dot is reached,
  // they close in on it. Without this script there are no rings; nothing else changes.
  const root = document.querySelector<HTMLElement>('[data-inward]');
  const svg = root?.querySelector<SVGSVGElement>('[data-rings]');
  const dot = root?.querySelector<HTMLElement>('[data-dot]');
  if (root && svg && dot) {
    const ns = 'http://www.w3.org/2000/svg';
    const draw = () => {
      const box = svg.getBoundingClientRect();
      const wrap = dot.parentElement!.getBoundingClientRect();
      const cx = wrap.left + wrap.width / 2 - box.left;
      const cy = wrap.top + wrap.height / 2 - box.top;
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      svg.style.transformOrigin = `${cx}px ${cy}px`;
      svg.replaceChildren();
      for (const s of root.querySelectorAll<HTMLElement>('[data-ring]')) {
        const c = document.createElementNS(ns, 'circle');
        c.setAttribute('cx', String(cx));
        c.setAttribute('cy', String(cy));
        c.setAttribute('r', String(cy - (s.getBoundingClientRect().top - box.top) + 32));
        svg.append(c);
      }
    };
    draw();
    new ResizeObserver(draw).observe(root);
  }

  // On This Day: today's date, and the year turning back one when the slip comes into view.
  const otd = document.querySelector<HTMLElement>('.otd');
  if (otd) {
    const day = otd.querySelector<HTMLElement>('[data-otd-day]');
    const locale = otd.dataset.locale ?? 'en-GB';
    // App style: 10 OCT (three-letter month, whatever the browser's short form is).
    const short = (d: Date) => {
      const p = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' }).formatToParts(d);
      const get = (k: string) => p.find((x) => x.type === k)?.value ?? '';
      return `${get('day')} ${get('month').replace('.', '').slice(0, 3)}`;
    };
    if (day) day.textContent = short(new Date());
    // Rows: today's entries, dated relative to today, app order (10 OCT · KUTA).
    for (const meta of document.querySelectorAll<HTMLElement>('[data-days]')) {
      if (!meta.dataset.place) continue;
      const d = new Date();
      d.setDate(d.getDate() - Number(meta.dataset.days));
      meta.textContent = `${short(d)} · ${meta.dataset.place}`;
    }
  }
  // Look back: a dotted teak line from each day to where it happened on the map, drawn as the
  // rows are dealt. Pin positions are measured on the map capture (fractions of the screen).
  const PINS: Record<string, [number, number]> = { Kuta: [0.848, 0.465], Jakarta: [0.142, 0.366], Yogyakarta: [0.441, 0.429] };
  const linkSvg = document.querySelector<SVGSVGElement>('[data-links]');
  const drawLinks = () => {
    const art = linkSvg?.parentElement;
    const screen = art?.querySelector<HTMLElement>('.phone-screen');
    if (!linkSvg || !art || !screen || innerWidth < 1024) { linkSvg?.replaceChildren(); return; }
    const a = art.getBoundingClientRect(), sc = screen.getBoundingClientRect();
    linkSvg.setAttribute('viewBox', `0 0 ${a.width} ${a.height}`);
    const ns = 'http://www.w3.org/2000/svg';
    const out: SVGElement[] = [];
    art.querySelectorAll<HTMLElement>('[data-pin]').forEach((row, n) => {
      const pin = PINS[row.dataset.pin ?? ''];
      if (!pin) return;
      const r = row.getBoundingClientRect();
      const x1 = r.right - a.left - 8, y1 = r.top + r.height / 2 - a.top;
      const x2 = sc.left - a.left + pin[0] * sc.width, y2 = sc.top - a.top + pin[1] * sc.height;
      const path = document.createElementNS(ns, 'path');
      const mx = (x1 + x2) / 2;
      path.setAttribute('d', `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`);
      path.setAttribute('pathLength', '1');
      path.style.setProperty('--d', String(n));
      const ring = document.createElementNS(ns, 'circle');
      ring.setAttribute('cx', String(x2)); ring.setAttribute('cy', String(y2)); ring.setAttribute('r', '9');
      ring.style.setProperty('--d', String(n));
      out.push(path, ring);
    });
    linkSvg.replaceChildren(...out);
  };
  addEventListener('resize', drawLinks);

  const back = document.querySelector<HTMLElement>('[data-back]');
  if (back && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    back.classList.add('waiting');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      back.classList.replace('waiting', 'shown');
      // Rows settle (rotated slips), then the lines can be measured.
      setTimeout(drawLinks, 50);
    }, { threshold: 0.35 });
    io.observe(back);
  }
</script>

<style>
  .inward {
    position: relative;
    max-width: var(--page);
    margin: 0 auto;
    timeline-scope: --dot;
  }
  .rings {
    position: absolute;
    top: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }
  .rings :global(circle) { fill: none; stroke: var(--rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  section { position: relative; }

  /* Weight carries rank on the site: display 600, section 500, everything read 400. */
  h1, h2 { font-weight: 500; text-wrap: balance; margin: 0; font-optical-sizing: auto; }
  h2 :global(em), h1 .em { font-style: italic; font-weight: 400; }
  h2 {
    font-size: clamp(2.25rem, 1.35rem + 3.3vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.022em;
    margin-bottom: 1.25rem;
  }
  p { margin: 0; text-wrap: pretty; }

  /* Hero */
  .hero {
    display: grid;
    gap: 3rem 4rem;
    align-items: center;
    padding: clamp(1.5rem, 6vh, 4.5rem) 0 clamp(6rem, 14vh, 9rem);
  }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 32rem); }
  }
  h1 {
    font-size: clamp(3rem, 1.6rem + 5vw, 6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 1.75rem;
  }
  .word { display: inline-block; margin-right: 0.22em; animation: bloom 420ms ease-out both; }
  .word:last-child { margin-right: 0; }
  /* The one teak phrase on the page's first screen. */
  h1 .em { color: var(--teak); letter-spacing: -0.02em; }
  .lead { font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem); line-height: 1.4; max-width: 26rem; margin-bottom: 1.5rem; }
  .kanji { font-size: 0.9375rem; color: var(--ink-2); max-width: 22rem; }
  .hero-text :global(.hero-badge) { margin-top: 2rem; }
  .hero-sheet { padding-bottom: 4rem; }


  /* Look back: the one real screen, with slips laid against it */
  .back { display: grid; gap: 3rem; padding: clamp(5rem, 12vh, 8rem) 0; }
  .back-text p, .felt-text p { font-size: 1.1875rem; line-height: 1.5; max-width: 32rem; }
  .back-art { display: grid; gap: 1.5rem; justify-items: center; }
  .back-art :global(.map) { width: min(18rem, 74vw); }
  .slips { display: grid; gap: 1rem; width: min(100%, 26rem); }
  .slip { background: var(--paper-raised); border-radius: 2px; padding: 1rem 1.125rem; }

  /* On This Day, as on Home: Teak Wash, square. */
  .otd { background: var(--teak-faded); border-radius: 0; box-shadow: var(--shadow-print); }
  .otd-label { display: flex; justify-content: space-between; gap: 1rem; color: var(--ink-2); margin-bottom: 0.875rem; }
  .otd-date { color: var(--ink); white-space: nowrap; }
  .year { display: inline-block; height: 1em; overflow: hidden; vertical-align: -0.12em; }
  .roll { display: grid; transition: translate 900ms var(--ease) 350ms; }
  .roll > span { height: 1em; line-height: 1; }
  .otd-row { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 0.875rem; }
  .thumb { width: 4rem; height: 5rem; padding: 4px 4px 20px; background: var(--polaroid-frame); border-radius: 2px; }
  .otd-meta { color: var(--ink-2); margin-bottom: 0.4rem; font-size: 0.6875rem; }
  .otd-title { font-size: 1.25rem; line-height: 1.2; margin-bottom: 0.25rem; }
  .otd-body { font-size: 0.9375rem; color: var(--ink-2); margin-bottom: 0.5rem; }
  .otd-mood { display: flex; align-items: center; gap: 0.3rem; font-size: 0.8125rem; color: var(--ink-2); }
  .otd-mood i { width: 5px; height: 5px; border-radius: 50%; background: var(--teak); }
  .rows { padding-block: 0.875rem 0.25rem; }
  .rows-head { color: var(--ink-3); }
  .rows .deal:last-child :global(.row) { border-bottom: 0; }

  /* Without JS the year shows last year's; with it, it rolls there. */
  .back-art:not(.waiting) .roll { translate: 0 -1em; }
  .waiting .deal { opacity: 0; translate: 0 -0.75rem; rotate: -1.5deg; }
  .shown .deal { animation: deal 520ms var(--ease) both; animation-delay: calc(var(--d) * 140ms + 300ms); }
  @keyframes deal { from { opacity: 0; translate: 0 -0.75rem; rotate: -1.5deg; } }

  @media (min-width: 64rem) {
    .back { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); align-items: center; gap: 3rem; }
    /* Slips laid against the phone's left edge, overlapping it a little. */
    .back-art { grid-template-columns: minmax(0, 1fr) auto; align-items: end; justify-items: stretch; gap: 0; }
    .slips { grid-area: 1 / 1; position: relative; z-index: 1; width: auto; margin: 0 3rem 3rem 0; rotate: -1.5deg; }
    .back-art :global(.map) { grid-area: 1 / 2; width: 18.5rem; }
  }

  /* The lines from each day to its pin */
  .links { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; overflow: visible; }
  .links :global(path) { fill: none; stroke: var(--teak); stroke-width: 1.5; stroke-dasharray: 0.012 0.012; stroke-linecap: round; }
  .links :global(circle) { fill: none; stroke: var(--teak); stroke-width: 1.5; }
  @media (prefers-reduced-motion: no-preference) {
    .links :global(path) { animation: link-draw 900ms var(--ease) both; animation-delay: calc(var(--d) * 140ms + 500ms); }
    .links :global(circle) { animation: pin-pulse 1.2s ease-out both; animation-delay: calc(var(--d) * 140ms + 1300ms); transform-box: fill-box; transform-origin: center; }
  }
  @keyframes link-draw { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes pin-pulse { 0% { scale: 0.3; opacity: 0; } 30% { opacity: 1; } 100% { scale: 1.6; opacity: 0; } }
  .back-art { position: relative; }

  /* How the days felt */
  .felt { padding: clamp(5rem, 12vh, 8rem) 0; display: grid; gap: 2.5rem; }
  .felt-text { position: relative; }
  .note { font-family: var(--hand); font-size: 1.375rem; color: var(--teak); rotate: -3deg; margin-top: 1rem; }
  @media (min-width: 64rem) {
    .felt-text { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 0 4rem; align-items: end; }
    .felt-text h2 { grid-row: span 2; margin: 0; }
    .note { justify-self: start; }
  }

  /* The ink dot: the private place at the centre. It grows as you reach it, and the rings close in. */
  .dot-wrap { padding: clamp(3rem, 8vh, 6rem) 0; view-timeline: --dot block; }
  .dot {
    width: max(150vw, 38rem);
    max-width: 52rem;
    aspect-ratio: 1;
    margin-left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    text-align: center;
  }
  .dot-text { width: min(30rem, 82vw); }
  .dot h2 { color: var(--paper); font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem); }
  .dot p { margin-bottom: 1rem; font-size: 1.0625rem; }
  .dot a { text-decoration-color: currentColor; }
  .dot ::selection { background: var(--paper); color: var(--ink); }
  .dot :focus-visible { outline-color: var(--paper); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .dot { animation: grow linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
      .dot-text { animation: arrive linear both; animation-timeline: view(); animation-range: entry 60% cover 50%; }
      .rings { animation: close-in linear both; animation-timeline: --dot; animation-range: entry 0% cover 50%; }
    }
  }
  @keyframes grow { from { scale: 0.06; } }
  @keyframes arrive { from { opacity: 0; filter: blur(4px); } }
  @keyframes close-in { to { scale: 0.86; } }

  /* Writing, and the rest of Oku, floating */
  .features { padding: clamp(5rem, 12vh, 8rem) 0; }

  /* Back out on the paper */
  .closing { display: grid; justify-items: center; text-align: center; gap: 0.75rem; padding: 1rem 0 5rem; }
  .closing-word { font-size: clamp(3rem, 2rem + 4vw, 5rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
  .closing-line { font-size: 1.25rem; color: var(--ink-2); margin-bottom: 1.25rem; }

</style>
