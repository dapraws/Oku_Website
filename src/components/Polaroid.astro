---
// DESIGN.md polaroid-large: a print, not a thumbnail. Photo is one of the app's painted demo scenes.
import Painting from './app/Painting.astro';
import type { Scene } from '../entries';
interface Props { scene: Scene; caption: string; tilt?: number; seed?: number; class?: string }
const { scene, caption, tilt = 0, seed = 1, class: className } = Astro.props;
---
<figure class:list={['polaroid', className]} style={`--tilt: ${tilt}deg`}>
  <div class="photo"><Painting scene={scene} seed={seed} /></div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  /* 12px sides and top, 40px caption band, Print shadow. */
  .polaroid {
    width: 15rem;
    margin: 0;
    padding: 0.75rem 0.75rem 0;
    background: var(--polaroid-frame);
    border-radius: 2px;
    box-shadow: var(--shadow-print);
    rotate: var(--tilt);
  }
  .photo {
    aspect-ratio: 1;
    box-shadow: 0 0 0 0.5px var(--polaroid-hairline);
  }
  figcaption {
    height: 2.5rem;
    display: grid;
    place-items: center;
    padding: 0 0.25rem;
    font-family: var(--caption);
    font-size: 1.125rem;
    color: var(--polaroid-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
