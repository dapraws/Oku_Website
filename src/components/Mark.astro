---
// The circle-in-circle mark: the world, and the private place inside it.
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <circle cx="20" cy="20" r="14" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  <circle cx="20" cy="20" r="4" fill="currentColor" />
</svg>
