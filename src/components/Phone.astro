---
// An app screen in an iPhone frame (the same bezel as the App Store images).
// Screen inset measured on the 1022 x 2082 frame: 52 / 46 / 918 x 1990, corner 126.
import { Image } from 'astro:assets';
import Screen from './Screen.astro';
import frame from '../assets/iphone-frame.webp';
import type { Lang } from '../i18n';

interface Props { lang: Lang; name: string; alt: string; class?: string }
const { lang, name, alt, class: className } = Astro.props;
---
<div class:list={['phone', className]}>
  <Screen lang={lang} name={name} alt={alt} class="phone-screen" />
  <span class="island" aria-hidden="true"></span>
  <Image src={frame} alt="" class="phone-frame" widths={[400, 700, 1022]} sizes="20rem" loading="lazy" />
</div>

<style>
  .phone {
    position: relative;
    aspect-ratio: 1022 / 2082;
    filter: drop-shadow(0 24px 40px rgba(26, 22, 20, 0.18)) drop-shadow(0 2px 6px rgba(26, 22, 20, 0.1));
  }
  .phone :global(.phone-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* The frame's screen is opaque, so the capture sits above it, clipped to the display. */
  .phone :global(.phone-screen) {
    position: absolute;
    z-index: 1;
    left: calc(52 / 1022 * 100%);
    top: calc(46 / 2082 * 100%);
    width: calc(918 / 1022 * 100%);
    height: calc(1990 / 2082 * 100%);
    border-radius: calc(126 / 918 * 100%) / calc(126 / 1990 * 100%);
    overflow: hidden;
  }
  .phone :global(.phone-screen img) { height: 100%; object-fit: cover; border-radius: 0; box-shadow: none; }
  /* Dynamic Island, over the status bar gap. */
  .island {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: calc((46 + 31) / 2082 * 100%);
    width: calc(918 / 1022 * 28.6%);
    aspect-ratio: 126 / 37;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }
</style>
