---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/schoolbell/latin-400.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { chrome, href, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
}
const { lang, page, title, description } = Astro.props;
const t = chrome[lang];
const other = t.other;
const canonical = new URL(href(lang, page), Astro.site);
const alternates = (['en', 'id'] as const).map((l) => ({ l, url: new URL(href(l, page), Astro.site) }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Apply a theme picked on the page before first paint (per-viewer, optional). -->
    <script is:inline>try{var t=localStorage.getItem('oku-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ l, url }) => <link rel="alternate" hreflang={l} href={url} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(href('en', page), Astro.site)} />
    <meta name="theme-color" content="#E8E3D3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161412" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />
    <meta property="og:site_name" content="Oku" />
    <meta property="og:image" content={new URL(`/og-${lang}.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="apple-itunes-app" content="app-id=6818423084" />
    {page === '' && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MobileApplication',
      name: lang === 'en' ? 'Oku: Daily Journal' : 'Oku: Jurnal Harian',
      operatingSystem: 'iOS',
      applicationCategory: 'LifestyleApplication',
      inLanguage: ['en', 'id'],
      description,
      url: canonical.href,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'Muhammad Darrel Prawira' },
    })} />}
  </head>
  <body>
    <a class="skip label" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={href(lang, '')} aria-label={t.home}>
        <Mark size={28} />
        <span class="wordmark" aria-hidden="true">Oku</span>
      </a>
      <nav class="nav">
        <a class="label" href={href(lang, 'support')} aria-current={page === 'support' ? 'page' : undefined}>{t.support}</a>
        <a class="label" href={href(other, page)} hreflang={other} lang={other}>{t.otherName}</a>
        <!-- Theme: the mark turns over. Light page: ring and dot. Dark page: a full disc. -->
        <button type="button" class="theme" data-theme-toggle data-to-dark={t.toDark} data-to-light={t.toLight} aria-label={t.toDark} title={t.toDark}>
          <svg width="22" height="22" viewBox="0 0 40 40" aria-hidden="true">
            <circle class="disc" cx="20" cy="20" r="14" />
            <circle class="core" cx="20" cy="20" r="4" />
          </svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="footer-links">
        <a href={href(lang, 'privacy')} aria-current={page === 'privacy' ? 'page' : undefined}>{t.privacy}</a>
        <a href={href(lang, 'terms')} aria-current={page === 'terms' ? 'page' : undefined}>{t.terms}</a>
        <a href={href(lang, 'support')} aria-current={page === 'support' ? 'page' : undefined}>{t.support}</a>
      </nav>
      <p class="label">{t.copyright}</p>
    </footer>
    <script is:inline>
      (function () {
        var b = document.querySelector('[data-theme-toggle]');
        if (!b) return;
        var root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)');
        var dark = function () { return root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches; };
        var label = function () { var l = dark() ? b.dataset.toLight : b.dataset.toDark; b.setAttribute('aria-label', l); b.title = l; };
        label();
        mq.addEventListener('change', label);
        b.addEventListener('click', function () {
          var next = dark() ? 'light' : 'dark';
          // Back to the system's choice: forget the override, so the site follows it again.
          var system = next === (mq.matches ? 'dark' : 'light');
          if (system) delete root.dataset.theme; else root.dataset.theme = next;
          try { system ? localStorage.removeItem('oku-theme') : localStorage.setItem('oku-theme', next); } catch (e) {}
          b.classList.remove('turned'); void b.offsetWidth; b.classList.add('turned');
          label();
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header,
  .site-footer {
    width: 100%;
    max-width: var(--page);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    text-decoration: none;
    color: var(--ink);
  }
  .wordmark { font-size: 1.375rem; font-weight: 500; line-height: 1; }

  .nav { display: flex; align-items: center; gap: 1.5rem; }
  .theme {
    display: inline-grid; place-items: center;
    width: 44px; height: 44px; margin-right: -11px;
    border: 0; background: none; cursor: pointer; color: var(--ink);
  }
  .theme .disc { fill: transparent; stroke: currentColor; stroke-width: 1.6; transition: fill 320ms ease-out; }
  .theme .core { fill: currentColor; transition: fill 320ms ease-out; }
  :global(:root[data-theme='dark']) .theme .disc { fill: var(--ink); }
  :global(:root[data-theme='dark']) .theme .core { fill: var(--paper); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme .disc { fill: var(--ink); }
    :global(:root:not([data-theme='light'])) .theme .core { fill: var(--paper); }
  }
  .theme.turned svg { animation: bloom 320ms ease-out; }
  .theme:hover svg { scale: 1.08; }
  .theme svg { transition: scale 200ms ease-out; }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .nav a:hover { color: var(--ink); }
  /* The tab bar's teak strip marks the page you are on. */
  .nav a[aria-current='page'] { color: var(--ink); }
  .nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 16px;
    height: 2px;
    background: var(--teak);
  }

  /* Clips the full-bleed rings and the ink dot at the screen edge. */
  main { flex: 1; padding: 2rem var(--gutter) 4rem; overflow-x: clip; }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 2.5rem;
    border-top: var(--hairline) solid var(--rule);
  }
  .footer-links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .footer-links a[aria-current='page'] { color: var(--ink); text-decoration-color: var(--teak); }
  .site-footer p { margin: 0; color: var(--ink-2); }

  @media (max-width: 30rem) {
    .site-footer { flex-direction: column; align-items: flex-start; }
  }
</style>
